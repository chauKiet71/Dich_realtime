# Cloudflare performs both speech recognition and text translation.
PORT=3000
TRANSLATION_ENGINE=hybrid
TRANSLATION_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-32-character-account-id
CLOUDFLARE_API_TOKEN_FILE=C:/path/to/cloudflare-token.txt
CLOUDFLARE_TRANSLATE_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
GOOGLE_TTS_API_KEY_FILE=C:/path/to/google-tts.txt
# Production: CLOUDFLARE_API_TOKEN and GOOGLE_TTS_API_KEY, not local file paths.
# Cloudflare file: one raw token, or a single API Token/Get API Token field.

# Legacy providers, only used after changing TRANSLATION_PROVIDER or ENGINE.
# OpenRouter and 9Router use OpenAI for speech recognition.
OPENAI_API_KEY_FILE=C:/path/to/openai-key.txt
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
ROUTER_BASE_URL=https://9router-production-95ca.up.railway.app/v1
ROUTER_TRANSLATE_MODEL=gemini/gemini-3-flash-preview
ROUTER_API_KEY_FILE=C:/path/to/9router.txt
OPENROUTER_TRANSLATE_MODEL=deepseek/deepseek-v3.2
OPENROUTER_API_KEY_FILE=C:/path/to/openrouter.txt
# Production: OPENAI_API_KEY plus OPENROUTER_API_KEY or ROUTER_API_KEY.
